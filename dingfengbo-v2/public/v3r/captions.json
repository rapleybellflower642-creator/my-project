[
  {
    "text": "因诗入狱。",
    "startMs": 150,
    "endMs": 1950,
    "timestampMs": 150,
    "confidence": null
  },
  {
    "text": "被贬黄州。",
    "startMs": 2100,
    "endMs": 3780,
    "timestampMs": 2100,
    "confidence": null
  },
  {
    "text": "他凭什么说：谁怕？",
    "startMs": 3950,
    "endMs": 7000,
    "timestampMs": 3950,
    "confidence": null
  },
  {
    "text": "1080年，苏轼贬居黄州。",
    "startMs": 7300,
    "endMs": 11000,
    "timestampMs": 7300,
    "confidence": null
  },
  {
    "text": "有官衔，却不得签署公事。",
    "startMs": 11400,
    "endMs": 17800,
    "timestampMs": 11400,
    "confidence": null
  },
  {
    "text": "生活困顿，他躬耕东坡。",
    "startMs": 18250,
    "endMs": 23300,
    "timestampMs": 18250,
    "confidence": null
  },
  {
    "text": "也在这里，慢慢安顿自己。",
    "startMs": 23900,
    "endMs": 27800,
    "timestampMs": 23900,
    "confidence": null
  },
  {
    "text": "1082年，三月七日，沙湖道中。",
    "startMs": 28200,
    "endMs": 32900,
    "timestampMs": 28200,
    "confidence": null
  },
  {
    "text": "雨具先去，同行皆狼狈。",
    "startMs": 33250,
    "endMs": 37850,
    "timestampMs": 33250,
    "confidence": null
  },
  {
    "text": "莫听穿林打叶声。",
    "startMs": 38250,
    "endMs": 43400,
    "timestampMs": 38250,
    "confidence": null
  },
  {
    "text": "外界越喧闹，越要稳住自己的心。",
    "startMs": 44000,
    "endMs": 48800,
    "timestampMs": 44000,
    "confidence": null
  },
  {
    "text": "何妨吟啸且徐行。",
    "startMs": 49150,
    "endMs": 54700,
    "timestampMs": 49150,
    "confidence": null
  },
  {
    "text": "难关，还得一步一步走过去。",
    "startMs": 55100,
    "endMs": 58850,
    "timestampMs": 55100,
    "confidence": null
  },
  {
    "text": "竹杖芒鞋轻胜马。",
    "startMs": 59100,
    "endMs": 64250,
    "timestampMs": 59100,
    "confidence": null
  },
  {
    "text": "行装简朴，心也可以轻一些。",
    "startMs": 64600,
    "endMs": 67850,
    "timestampMs": 64600,
    "confidence": null
  },
  {
    "text": "谁怕？",
    "startMs": 68567,
    "endMs": 70733,
    "timestampMs": 68567,
    "confidence": null
  },
  {
    "text": "一蓑烟雨任平生。",
    "startMs": 70767,
    "endMs": 79850,
    "timestampMs": 70767,
    "confidence": null
  },
  {
    "text": "料峭春风吹酒醒，微冷。",
    "startMs": 80150,
    "endMs": 84700,
    "timestampMs": 80150,
    "confidence": null
  },
  {
    "text": "从容的人，也会觉得冷。",
    "startMs": 85000,
    "endMs": 87900,
    "timestampMs": 85000,
    "confidence": null
  },
  {
    "text": "山头斜照却相迎。",
    "startMs": 88700,
    "endMs": 96850,
    "timestampMs": 88700,
    "confidence": null
  },
  {
    "text": "回首向来萧瑟处。",
    "startMs": 97200,
    "endMs": 102000,
    "timestampMs": 97200,
    "confidence": null
  },
  {
    "text": "归去。",
    "startMs": 102300,
    "endMs": 105000,
    "timestampMs": 102300,
    "confidence": null
  },
  {
    "text": "走过的风雨，不必继续困住此刻的自己。",
    "startMs": 105300,
    "endMs": 110800,
    "timestampMs": 105300,
    "confidence": null
  },
  {
    "text": "也无风雨也无晴。",
    "startMs": 111400,
    "endMs": 119800,
    "timestampMs": 111400,
    "confidence": null
  }
]
