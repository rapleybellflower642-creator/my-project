    "@remotion/renderer": "4.0.535",
    "@remotion/three": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "@types/three": "0.180.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.535",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
